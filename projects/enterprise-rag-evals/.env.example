RAG_DB_PATH=./var/rag.sqlite3
RAG_LOG_LEVEL=INFO
RAG_MAX_UPLOAD_BYTES=5000000
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_RETRIEVAL_SCORE=0.08

# Optional provider adapter. Fixture mode does not need a key or network access.
RAG_PROVIDER=local
RAG_PROVIDER_BASE_URL=https://api.example.invalid/v1
RAG_PROVIDER_MODEL=replace-me
RAG_PROVIDER_API_KEY=
